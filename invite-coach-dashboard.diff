+  const COACH_ROLE_LABELS = {
+    head_coach: "Head Coach",
+    assistant_coach: "Assistant Coach",
+    graduate_assistant: "Graduate Assistant",
+    dbo: "DBO",
+  };
+
+  async function loadCoaches(programId) {
+    const { data: rows, error } = await supabase
+      .from("program_coaches")
+      .select("coach_id, role, can_publish, coaches ( email, display_name )")
+      .eq("program_id", programId)
+      .order("role");
+
+    const tbody = document.querySelector("#coaches-table tbody");
+    tbody.innerHTML = "";
+    if (error || !rows) return;
+
+    for (const row of rows) {
+      const tr = document.createElement("tr");
+      const name = row.coaches?.display_name || "&mdash;";
+      const email = row.coaches?.email || "&mdash;";
+      tr.innerHTML = `
+        <td>${name}</td>
+        <td>${email}</td>
+        <td><span class="pill">${COACH_ROLE_LABELS[row.role] || row.role}</span></td>
+        <td>${row.can_publish ? "Yes" : "No"}</td>
+      `;
+      tbody.appendChild(tr);
+    }
+  }
+
+  document.getElementById("invite-coach-btn")?.addEventListener("click", async () => {
+    const emailInput = document.getElementById("new-coach-email");
+    const roleSelect = document.getElementById("new-coach-role");
+    const canPublishCheckbox = document.getElementById("new-coach-can-publish");
+    const statusEl = document.getElementById("invite-coach-status");
+    const email = emailInput.value.trim();
+    if (!email || !currentProgramId) return;
+
+    const btn = document.getElementById("invite-coach-btn");
+    btn.disabled = true;
+    btn.textContent = "Inviting...";
+    statusEl.textContent = "";
+
+    const { data: { session } } = await supabase.auth.getSession();
+    let result;
+    try {
+      const res = await fetch("/api/invite-coach", {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+          Authorization: `Bearer ${session.access_token}`,
+        },
+        body: JSON.stringify({
+          programId: currentProgramId,
+          email,
+          role: roleSelect.value,
+          canPublish: canPublishCheckbox.checked,
+        }),
+      });
+      result = await res.json();
+      if (!res.ok) throw new Error(result.error || "Invite failed");
+    } catch (err) {
+      statusEl.className = "error";
+      statusEl.textContent = err.message;
+      btn.disabled = false;
+      btn.textContent = "Invite coach";
+      return;
+    }
+
+    statusEl.className = "";
+    statusEl.textContent = `Invited ${email}. They'll get a real Supabase login email to set their password.`;
+    emailInput.value = "";
+    canPublishCheckbox.checked = false;
+    btn.disabled = false;
+    btn.textContent = "Invite coach";
+    await loadCoaches(currentProgramId);
+  });
+
